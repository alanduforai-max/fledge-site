{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "fledge-site",
  "account_id": "a113a1d209051e05e8af6ccd11b1d412",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker.js",
  "assets": {
    "directory": "dist-site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "routes": [
    { "pattern": "fledgetradelab.com", "custom_domain": true, "zone_name": "fledgetradelab.com" },
    { "pattern": "www.fledgetradelab.com", "custom_domain": true, "zone_name": "fledgetradelab.com" }
  ],
  // 2026-08-22 事件街后端退役：D1 `fledge-play`（已导出备份后删库）和
  // PlayRoom Durable Object 一起下线，玩法搬去 AgentFloor。DO 的类必须走
  // deleted_classes 迁移才能干净移除，v2 就是干这个的 —— 别删这条记录。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlayRoom"] },
    { "tag": "v2", "deleted_classes": ["PlayRoom"] }
  ],
  "vars": {
    "SITE_ORIGIN": "https://fledgetradelab.com"
  }
  // 不再需要任何 secret：账号系统随事件街一起退役。
  // 旧的 SESSION_SECRET / RESEND_API_KEY / EMAIL_FROM / GOOGLE_CLIENT_ID /
  // GOOGLE_CLIENT_SECRET 还留在这个 worker 上，没有代码读它们了，可随时
  // `wrangler secret delete` 清掉（同名的值在 fledge-grounds 和 agentfloor
  // 上各有一份，删这里不影响那两个）。
}
